  "regions": [
    {
      "id": "guanzhong",
      "name": "關中長安",
      "place": "長安",
      "w": 22,
      "desc": "八百里秦川。開皇二年起，朝廷在漢長安城的東南另築新都大興城，關中的田不夠分，人卻越來越多。"
    },
    {
      "id": "luoyang",
      "name": "河南洛陽",
      "place": "洛陽",
      "w": 15,
      "desc": "天下之中，洛水穿城而過。北周時已殘破，大業元年起又要在這裡築起一座東都。"
    },
    {
      "id": "hebei",
      "name": "河北清河",
      "place": "清河",
      "w": 17,
      "desc": "永濟渠以東的大平原，桑麻遍地，出絹也出兵。地勢低，黃河、永濟渠一漲水，十幾個縣都泡在水裡。"
    },
    {
      "id": "yangzhou",
      "name": "揚州江都",
      "place": "江都",
      "w": 13,
      "desc": "長江北岸，邗溝南口。南北的糧船、鹽船都打這裡經過，城裡的胡商比別處多。"
    },
    {
      "id": "yizhou",
      "name": "蜀中成都",
      "place": "成都",
      "w": 11,
      "desc": "群山圍著的平原，都江堰的水灌著稻田，織錦的機聲日夜不停。天下亂了，這裡常是最後亂的。"
    },
    {
      "id": "shazhou",
      "name": "河西敦煌",
      "place": "敦煌",
      "w": 8,
      "desc": "沙漠邊上的綠洲，往西出了玉門、陽關就是西域。城東南的鳴沙山崖上，一代一代的人在鑿佛窟。"
    },
    {
      "id": "lingnan",
      "name": "嶺南廣州",
      "place": "南海",
      "w": 9,
      "desc": "五嶺以南，靠著大海。番舶從獅子國、波斯來，帶著香料和象牙。開皇初年，這裡還是陳朝的地方。"
    },
    {
      "id": "xizhou",
      "name": "西州高昌",
      "place": "高昌",
      "w": 0,
      "desc": "火焰山下的綠洲。原是麴氏高昌國，貞觀十四年歸唐，改為西州。坎兒井的水從地底下流過來。"
    }
  ],
  "classes": [
    {
      "id": "junfarmer",
      "name": "均田農戶",
      "w": 34,
      "rank": 2,
      "stats": {
        "武": 5,
        "文": 2,
        "德": 5,
        "名": 1,
        "財": 5
      },
      "family": [
        "家裡受了官府的田，永業田種桑，口分田種糧。田在籍帳上寫得清清楚楚，一畝也不能賣。",
        "父親常說，田是官府授的，命是自己的。種好田、交了租調，一家人就餓不死。"
      ]
    },
    {
      "id": "kehu",
      "name": "莊上客戶",
      "w": 14,
      "rank": 0,
      "stats": {
        "武": 6,
        "文": 1,
        "德": 5,
        "名": 0,
        "財": 2
      },
      "family": [
        "祖上是逃荒來的，在本地沒有籍，寄住在大戶的莊上替人種地，收成先交莊主。",
        "家裡在{place}沒有自己的田，也不在籍帳上。父親說，在官府眼裡，咱們家是不存在的。"
      ]
    },
    {
      "id": "fubing",
      "name": "府兵之家",
      "w": 12,
      "rank": 2,
      "regions": [
        "guanzhong",
        "luoyang",
        "hebei",
        "shazhou"
      ],
      "stats": {
        "武": 9,
        "文": 1,
        "德": 5,
        "名": 2,
        "財": 5
      },
      "family": [
        "家裡世代是府兵，平時種地，輪到番上就背著自備的弓刀、乾糧去京師宿衛。",
        "祖父從周朝起就在軍府裡，牆上掛著一副舊皮甲。家裡的男孩子，生下來就注定要當兵。"
      ]
    },
    {
      "id": "gongshang",
      "name": "工匠商販",
      "w": 10,
      "rank": 2,
      "stats": {
        "武": 3,
        "文": 3,
        "德": 4,
        "名": 1,
        "財": 10
      },
      "family": [
        "父親在{place}的市上有一間小鋪子，打鐵、補鍋，也收舊銅。按規矩，工商人家的孩子不許讀書應舉。",
        "家裡是織匠，母親和姊姊整天坐在織機前。官府要的絹、市上要的綾，都從這架機子上出來。"
      ]
    },
    {
      "id": "siyuan",
      "name": "寺莊佃戶",
      "w": 7,
      "rank": 1,
      "stats": {
        "武": 4,
        "文": 3,
        "德": 7,
        "名": 0,
        "財": 3
      },
      "family": [
        "家裡種的是寺院的莊田。每年秋收，寺裡的知事僧拿著帳簿來，一斗一斗地量。",
        "母親信佛，每月初一十五都去寺裡上香。家裡種的田是寺院的，伯父在寺裡做淨人，替和尚們挑水劈柴。"
      ]
    },
    {
      "id": "lizheng",
      "name": "里正之家",
      "w": 7,
      "rank": 3,
      "lettered": true,
      "stats": {
        "武": 3,
        "文": 9,
        "德": 5,
        "名": 3,
        "財": 8
      },
      "family": [
        "父親是里正，百戶人家的戶籍、手實、差科都經他的手。鄰里見了他客客氣氣，背地裡也有人罵。",
        "家裡有幾十畝田，也有一間堆滿籍帳的屋子。父親寫得一手好字，每年歲末都要熬夜造帳。"
      ]
    },
    {
      "id": "gentry_gl",
      "name": "關隴士族旁支",
      "w": 3,
      "rank": 4,
      "lettered": true,
      "regions": [
        "guanzhong",
        "shazhou"
      ],
      "stats": {
        "武": 7,
        "文": 12,
        "德": 5,
        "名": 7,
        "財": 14
      },
      "family": [
        "族裡的人從西魏、北周起就跟著宇文家打天下，出過幾個開府、儀同。到了你們這一支，只剩下祖上的官銜和一處莊園。",
        "家裡既讀書也習騎射。祖父常說，我們家的富貴是馬背上來的，不是筆桿上來的。"
      ]
    },
    {
      "id": "gentry_sd",
      "name": "山東士族旁支",
      "w": 4,
      "rank": 4,
      "lettered": true,
      "regions": [
        "hebei",
        "luoyang"
      ],
      "stats": {
        "武": 2,
        "文": 16,
        "德": 7,
        "名": 8,
        "財": 12
      },
      "family": [
        "族裡講究門第、禮法，婚姻只跟崔、盧、李、鄭幾家往來。只是到了你們這一支，田產已經不多，只剩一屋子書和一個好姓氏。",
        "家裡的長輩說，我們家的家法比朝廷的律令還早幾百年。你從會說話起就要學著行禮。"
      ]
    },
    {
      "id": "gentry_jn",
      "name": "江南士族旁支",
      "w": 4,
      "rank": 4,
      "lettered": true,
      "regions": [
        "yangzhou"
      ],
      "stats": {
        "武": 1,
        "文": 16,
        "德": 6,
        "名": 7,
        "財": 13
      },
      "family": [
        "族裡從永嘉南渡起就住在江南，說話帶著吳音，詩寫得好。祖父在陳朝做過官，陳亡以後就閉門不出了。",
        "家裡藏著好些南朝的書，祖母還記得建康城裡秦淮河上的燈火。北方來的人說話，家裡的長輩聽了總要皺眉。"
      ]
    },
    {
      "id": "hu",
      "name": "粟特胡人",
      "w": 5,
      "rank": 2,
      "regions": [
        "guanzhong",
