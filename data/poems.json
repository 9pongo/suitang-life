{
  "_說明": "雜報上偶爾刊出的詩。year 是能確定已經寫成、開始傳抄的年份（拿不準的往後放，免得詩還沒寫就先登出來）；regions 是跟這首詩有關的地方，住在那裡的人比較容易讀到。",
  "poems": [
    { "id": "xue_renri", "year": 585, "author": "薛道衡", "title": "人日思歸", "lines": ["入春才七日，", "離家已二年。", "人歸落雁後，", "思發在花前。"], "note": "薛道衡奉使南朝陳時作。" },
    { "id": "wangbo_liaodong", "year": 611, "author": "王薄", "title": "無向遼東浪死歌", "lines": ["長白山前知世郎，", "純著紅羅錦背襠。", "長槊侵天半，", "輪刀耀日光。", "上山喫獐鹿，", "下山喫牛羊。", "忽聞官軍至，", "提刀向前蕩。", "譬如遼東死，", "斬頭何所傷。"], "regions": ["hebei", "luoyang"], "note": "大業七年王薄在長白山起兵，作此歌招引逃避征遼的人（《資治通鑑》卷一八一記其事，歌辭見於後世輯本）。" },
    { "id": "wangji_yewang", "year": 630, "author": "王績", "title": "野望", "lines": ["東皋薄暮望，", "徙倚欲何依。", "樹樹皆秋色，", "山山唯落暉。", "牧人驅犢返，", "獵馬帶禽歸。", "相顧無相識，", "長歌懷采薇。"] },
    { "id": "yu_chan", "year": 630, "author": "虞世南", "title": "蟬", "lines": ["垂緌飲清露，", "流響出疏桐。", "居高聲自遠，", "非是藉秋風。"], "regions": ["guanzhong"] },
    { "id": "fanzhi_mantou", "year": 660, "author": "王梵志", "title": "城外土饅頭", "lines": ["城外土饅頭，", "餡草在城裏。", "一人喫一箇，", "莫嫌沒滋味。"], "regions": ["shazhou"], "note": "王梵志的白話詩在民間流傳極廣，敦煌藏經洞出土了好幾種抄本。" },
    { "id": "luo_e", "year": 660, "author": "駱賓王", "title": "詠鵝", "lines": ["鵝，鵝，鵝，", "曲項向天歌。", "白毛浮綠水，", "紅掌撥清波。"], "note": "相傳是駱賓王七歲時所作。" },
    { "id": "wangbo_shuzhou", "year": 672, "author": "王勃", "title": "送杜少府之任蜀州", "lines": ["城闕輔三秦，", "風煙望五津。", "與君離別意，", "同是宦遊人。", "海內存知己，", "天涯若比鄰。", "無為在歧路，", "兒女共沾巾。"], "regions": ["guanzhong", "yizhou"] },
    { "id": "chen_youzhou", "year": 697, "author": "陳子昂", "title": "登幽州臺歌", "lines": ["前不見古人，", "後不見來者。", "念天地之悠悠，", "獨愴然而涕下。"], "regions": ["hebei"], "note": "萬歲通天二年，陳子昂隨軍討契丹，登幽州臺而作。" },
    { "id": "song_hanjiang", "year": 706, "author": "宋之問", "title": "渡漢江", "lines": ["嶺外音書斷，", "經冬復歷春。", "近鄉情更怯，", "不敢問來人。"], "regions": ["lingnan", "luoyang"], "note": "一說李頻作。宋之問貶瀧州，神龍二年逃歸洛陽途中所作。" },
    { "id": "wangwei_chongyang", "year": 717, "author": "王維", "title": "九月九日憶山東兄弟", "lines": ["獨在異鄉為異客，", "每逢佳節倍思親。", "遙知兄弟登高處，", "遍插茱萸少一人。"], "note": "王維十七歲客居長安時作。" },
    { "id": "wangwan_beigu", "year": 723, "author": "王灣", "title": "次北固山下", "lines": ["客路青山外，", "行舟綠水前。", "潮平兩岸闊，", "風正一帆懸。", "海日生殘夜，", "江春入舊年。", "鄉書何處達，", "歸雁洛陽邊。"], "regions": ["yangzhou"] },
    { "id": "wanghan_liangzhou", "year": 725, "author": "王翰", "title": "涼州詞", "lines": ["葡萄美酒夜光杯，", "欲飲琵琶馬上催。", "醉臥沙場君莫笑，", "古來征戰幾人回。"], "regions": ["shazhou", "xizhou"] },
    { "id": "libai_yesi", "year": 726, "author": "李白", "title": "靜夜思", "lines": ["床前看月光，", "疑是地上霜。", "舉頭望山月，", "低頭思故鄉。"], "regions": ["yangzhou"], "note": "開元十四年李白客居揚州時作。這裡照宋本，明代以後流行的本子作「床前明月光」「舉頭望明月」。" },
    { "id": "wangcl_chusai", "year": 727, "author": "王昌齡", "title": "出塞", "lines": ["秦時明月漢時關，", "萬里長征人未還。", "但使龍城飛將在，", "不教胡馬度陰山。"], "regions": ["shazhou", "xizhou", "hebei"] },
    { "id": "meng_chunxiao", "year": 730, "author": "孟浩然", "title": "春曉", "lines": ["春眠不覺曉，", "處處聞啼鳥。", "夜來風雨聲，", "花落知多少。"] },
    { "id": "libai_guangling", "year": 730, "author": "李白", "title": "黃鶴樓送孟浩然之廣陵", "lines": ["故人西辭黃鶴樓，", "煙花三月下揚州。", "孤帆遠影碧空盡，", "唯見長江天際流。"], "regions": ["yangzhou"] },
    { "id": "wangzh_liangzhou", "year": 735, "author": "王之渙", "title": "涼州詞", "lines": ["黃河遠上白雲間，", "一片孤城萬仞山。", "羌笛何須怨楊柳，", "春風不度玉門關。"], "regions": ["shazhou", "xizhou"] },
    { "id": "wangzh_guanque", "year": 735, "author": "王之渙", "title": "登鸛雀樓", "lines": ["白日依山盡，", "黃河入海流。", "欲窮千里目，", "更上一層樓。"], "regions": ["guanzhong", "luoyang"] },
    { "id": "dufu_wangyue", "year": 736, "author": "杜甫", "title": "望嶽", "lines": ["岱宗夫如何，", "齊魯青未了。", "造化鍾神秀，", "陰陽割昏曉。", "盪胸生層雲，", "決眥入歸鳥。", "會當凌絕頂，", "一覽眾山小。"], "regions": ["hebei"], "note": "杜甫早年漫遊齊趙時作。" },
    { "id": "zhang_wangyue", "year": 737, "author": "張九齡", "title": "望月懷遠", "lines": ["海上生明月，", "天涯共此時。", "情人怨遙夜，", "竟夕起相思。", "滅燭憐光滿，", "披衣覺露滋。", "不堪盈手贈，", "還寢夢佳期。"], "regions": ["lingnan"], "note": "張九齡是嶺南韶州人，開元二十五年貶荊州長史後所作。" },
    { "id": "he_huixiang", "year": 744, "author": "賀知章", "title": "回鄉偶書", "lines": ["少小離家老大回，", "鄉音無改鬢毛衰。", "兒童相見不相識，", "笑問客從何處來。"], "note": "天寶三載賀知章八十六歲，辭官回越州故鄉時作。" },
    { "id": "gaoshi_dongda", "year": 747, "author": "高適", "title": "別董大", "lines": ["千里黃雲白日曛，", "北風吹雁雪紛紛。", "莫愁前路無知己，", "天下誰人不識君。"] },
    { "id": "cen_rujing", "year": 749, "author": "岑參", "title": "逢入京使", "lines": ["故園東望路漫漫，", "雙袖龍鍾淚不乾。", "馬上相逢無紙筆，", "憑君傳語報平安。"], "regions": ["shazhou", "xizhou"], "note": "天寶八載岑參第一次出塞赴安西，途中遇到回長安的使者。" },
    { "id": "wangwei_luzhai", "year": 750, "author": "王維", "title": "鹿柴", "lines": ["空山不見人，", "但聞人語響。", "返景入深林，", "復照青苔上。"], "regions": ["guanzhong"], "note": "王維輞川別業二十景之一，在藍田。" },
    { "id": "wangwei_anxi", "year": 755, "author": "王維", "title": "送元二使安西", "lines": ["渭城朝雨浥輕塵，", "客舍青青柳色新。", "勸君更盡一杯酒，", "西出陽關無故人。"], "regions": ["guanzhong", "shazhou", "xizhou"] },
    { "id": "zhangji_fengqiao", "year": 757, "author": "張繼", "title": "楓橋夜泊", "lines": ["月落烏啼霜滿天，", "江楓漁火對愁眠。", "姑蘇城外寒山寺，", "夜半鐘聲到客船。"], "regions": ["yangzhou"], "note": "一般認為是安史之亂後張繼避亂江南時所作。" },
    { "id": "dufu_chunwang", "year": 757, "author": "杜甫", "title": "春望", "lines": ["國破山河在，", "城春草木深。", "感時花濺淚，", "恨別鳥驚心。", "烽火連三月，", "家書抵萬金。", "白頭搔更短，", "渾欲不勝簪。"], "regions": ["guanzhong"], "note": "至德二載春，杜甫陷在叛軍佔據的長安時作。" },
    { "id": "dufu_shedi", "year": 759, "author": "杜甫", "title": "月夜憶舍弟", "lines": ["戍鼓斷人行，", "邊秋一雁聲。", "露從今夜白，", "月是故鄉明。", "有弟皆分散，", "無家問死生。", "寄書長不達，", "況乃未休兵。"], "regions": ["luoyang", "hebei"] },
    { "id": "libai_baidi", "year": 759, "author": "李白", "title": "早發白帝城", "lines": ["朝辭白帝彩雲間，", "千里江陵一日還。", "兩岸猿聲啼不住，", "輕舟已過萬重山。"], "regions": ["yizhou"], "note": "乾元二年李白流放夜郎，行至白帝城遇赦東歸。" },
    { "id": "dufu_xiyu", "year": 761, "author": "杜甫", "title": "春夜喜雨", "lines": ["好雨知時節，", "當春乃發生。", "隨風潛入夜，", "潤物細無聲。", "野徑雲俱黑，", "江船火獨明。", "曉看紅濕處，", "花重錦官城。"], "regions": ["yizhou"], "note": "上元二年春，杜甫在成都草堂所作。" },
    { "id": "dufu_shouhebei", "year": 763, "author": "杜甫", "title": "聞官軍收河南河北", "lines": ["劍外忽傳收薊北，", "初聞涕淚滿衣裳。", "卻看妻子愁何在，", "漫卷詩書喜欲狂。", "白日放歌須縱酒，", "青春作伴好還鄉。", "即從巴峽穿巫峽，", "便下襄陽向洛陽。"], "note": "廣德元年春，杜甫在梓州聽到叛亂平定的消息。" }
  ]
}
