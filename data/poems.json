{
  "_說明": "雜報上偶爾刊出的詩。year 是能確定已經寫成、開始傳抄的年份（拿不準的往後放，免得詩還沒寫就先登出來）；regions 是跟這首詩有關的地方，住在那裡的人比較容易讀到。",
  "poems": [
    { "id": "yuxin_zhou", "year": 581, "author": "庾信", "title": "重別周尚書", "lines": ["陽關萬里道，", "不見一人歸。", "惟有河邊雁，", "秋來南向飛。"], "regions": ["guanzhong"], "note": "庾信由梁入北周，羈留長安至死，詩寫南人北留之苦。" },
    { "id": "chenhou_houting", "year": 584, "author": "陳叔寶", "title": "玉樹後庭花", "lines": ["麗宇芳林對高閣，", "新妝豔質本傾城。", "映戶凝嬌乍不進，", "出帷含態笑相迎。", "妖姬臉似花含露，", "玉樹流光照後庭。"], "regions": ["yangzhou", "lingnan"], "note": "陳後主在建康宮中所作，宮人傳唱。" },
    { "id": "xue_renri", "year": 585, "author": "薛道衡", "title": "人日思歸", "lines": ["入春才七日，", "離家已二年。", "人歸落雁後，", "思發在花前。"], "note": "薛道衡奉使南朝陳時作。" },
    { "id": "yangguang_chunjiang", "year": 608, "author": "楊廣", "title": "春江花月夜", "lines": ["暮江平不動，", "春花滿正開。", "流波將月去，", "潮水帶星來。"], "regions": ["yangzhou"], "note": "隋煬帝所作二首之一。" },
    { "id": "yangguang_yewang", "year": 610, "author": "楊廣", "title": "野望", "lines": ["寒鴉飛數點，", "流水繞孤村。", "斜陽欲落處，", "一望黯銷魂。"], "regions": ["luoyang", "yangzhou"], "note": "相傳是隋煬帝所作。" },
    { "id": "wangbo_liaodong", "year": 611, "author": "王薄", "title": "無向遼東浪死歌", "lines": ["長白山前知世郎，", "純著紅羅錦背襠。", "長槊侵天半，", "輪刀耀日光。", "上山喫獐鹿，", "下山喫牛羊。", "忽聞官軍至，", "提刀向前蕩。", "譬如遼東死，", "斬頭何所傷。"], "regions": ["hebei", "luoyang"], "note": "大業七年王薄在長白山起兵，作此歌招引逃避征遼的人（《資治通鑑》卷一八一記其事，歌辭見於後世輯本）。" },
    { "id": "sui_songbie", "year": 612, "author": "無名氏", "title": "送別詩", "lines": ["楊柳青青著地垂，", "楊花漫漫攪天飛。", "柳條折盡花飛盡，", "借問行人歸不歸。"], "note": "隋末流傳的民間送別詩。" },
    { "id": "kong_luoye", "year": 618, "author": "孔紹安", "title": "落葉", "lines": ["早秋驚落葉，", "飄零似客心。", "翻飛未肯下，", "猶言惜故林。"], "note": "孔紹安由隋入唐，隋末亂世中所作。" },
    { "id": "wangji_jiujia", "year": 625, "author": "王績", "title": "過酒家", "lines": ["此日長昏飲，", "非關養性靈。", "眼看人盡醉，", "何忍獨為醒。"] },
    { "id": "wangji_yewang", "year": 630, "author": "王績", "title": "野望", "lines": ["東皋薄暮望，", "徙倚欲何依。", "樹樹皆秋色，", "山山唯落暉。", "牧人驅犢返，", "獵馬帶禽歸。", "相顧無相識，", "長歌懷采薇。"] },
    { "id": "yu_chan", "year": 630, "author": "虞世南", "title": "蟬", "lines": ["垂緌飲清露，", "流響出疏桐。", "居高聲自遠，", "非是藉秋風。"], "regions": ["guanzhong"] },
    { "id": "wangji_qiuye", "year": 630, "author": "王績", "title": "秋夜喜遇王處士", "lines": ["北場芸藿罷，", "東皋刈黍歸。", "相逢秋月滿，", "更值夜螢飛。"] },
    { "id": "taizong_xiaoyu", "year": 635, "author": "李世民", "title": "賜蕭瑀", "lines": ["疾風知勁草，", "板蕩識誠臣。", "勇夫安識義，", "智者必懷仁。"], "regions": ["guanzhong"], "note": "唐太宗賜給宰相蕭瑀的詩。" },
    { "id": "fanzhi_mantou", "year": 660, "author": "王梵志", "title": "城外土饅頭", "lines": ["城外土饅頭，", "餡草在城裏。", "一人喫一箇，", "莫嫌沒滋味。"], "regions": ["shazhou"], "note": "王梵志的白話詩在民間流傳極廣，敦煌藏經洞出土了好幾種抄本。" },
    { "id": "luo_e", "year": 660, "author": "駱賓王", "title": "詠鵝", "lines": ["鵝，鵝，鵝，", "曲項向天歌。", "白毛浮綠水，", "紅掌撥清波。"], "note": "相傳是駱賓王七歲時所作。" },
    { "id": "fanzhi_damma", "year": 660, "author": "王梵志", "title": "他人騎大馬", "lines": ["他人騎大馬，", "我獨跨驢子。", "回顧擔柴漢，", "心下較些子。"], "regions": ["shazhou"] },
    { "id": "shangguan_luodi", "year": 662, "author": "上官儀", "title": "入朝洛堤步月", "lines": ["脈脈廣川流，", "驅馬歷長洲。", "鵲飛山月曙，", "蟬噪野風秋。"], "regions": ["luoyang"], "note": "龍朔年間，上官儀在洛陽候朝時所作，當時人爭相傳誦。" },
    { "id": "wangbo_shuzhou", "year": 672, "author": "王勃", "title": "送杜少府之任蜀州", "lines": ["城闕輔三秦，", "風煙望五津。", "與君離別意，", "同是宦遊人。", "海內存知己，", "天涯若比鄰。", "無為在歧路，", "兒女共沾巾。"], "regions": ["guanzhong", "yizhou"] },
    { "id": "wangbo_shanzhong", "year": 672, "author": "王勃", "title": "山中", "lines": ["長江悲已滯，", "萬里念將歸。", "況屬高風晚，", "山山黃葉飛。"], "regions": ["yizhou"], "note": "王勃客居蜀中時作。" },
    { "id": "luo_chan", "year": 679, "author": "駱賓王", "title": "在獄詠蟬", "lines": ["西陸蟬聲唱，", "南冠客思侵。", "那堪玄鬢影，", "來對白頭吟。", "露重飛難進，", "風多響易沉。", "無人信高潔，", "誰為表予心。"], "regions": ["guanzhong"], "note": "儀鳳三年，駱賓王任侍御史時下獄，在獄中所作。" },
    { "id": "luo_yishui", "year": 680, "author": "駱賓王", "title": "於易水送人", "lines": ["此地別燕丹，", "壯士髮衝冠。", "昔時人已沒，", "今日水猶寒。"], "regions": ["hebei"] },
    { "id": "yangjiong_congjun", "year": 682, "author": "楊炯", "title": "從軍行", "lines": ["烽火照西京，", "心中自不平。", "牙璋辭鳳闕，", "鐵騎繞龍城。", "雪暗凋旗畫，", "風多雜鼓聲。", "寧為百夫長，", "勝作一書生。"], "regions": ["guanzhong"] },
    { "id": "dushenyan_jinling", "year": 690, "author": "杜審言", "title": "和晉陵陸丞早春遊望", "lines": ["獨有宦遊人，", "偏驚物候新。", "雲霞出海曙，", "梅柳渡江春。", "淑氣催黃鳥，", "晴光轉綠蘋。", "忽聞歌古調，", "歸思欲沾巾。"], "regions": ["yangzhou"], "note": "杜審言在江陰做官時所作。他是杜甫的祖父。" },
    { "id": "zhangyue_shudao", "year": 695, "author": "張說", "title": "蜀道後期", "lines": ["客心爭日月，", "來往預期程。", "秋風不相待，", "先至洛陽城。"], "regions": ["yizhou", "luoyang"] },
    { "id": "chen_youzhou", "year": 697, "author": "陳子昂", "title": "登幽州臺歌", "lines": ["前不見古人，", "後不見來者。", "念天地之悠悠，", "獨愴然而涕下。"], "regions": ["hebei"], "note": "萬歲通天二年，陳子昂隨軍討契丹，登幽州臺而作。" },
    { "id": "liqiao_feng", "year": 700, "author": "李嶠", "title": "風", "lines": ["解落三秋葉，", "能開二月花。", "過江千尺浪，", "入竹萬竿斜。"] },
    { "id": "song_hanjiang", "year": 706, "author": "宋之問", "title": "渡漢江", "lines": ["嶺外音書斷，", "經冬復歷春。", "近鄉情更怯，", "不敢問來人。"], "regions": ["lingnan", "luoyang"], "note": "一說李頻作。宋之問貶瀧州，神龍二年逃歸洛陽途中所作。" },
    { "id": "shen_zashi", "year": 710, "author": "沈佺期", "title": "雜詩", "lines": ["聞道黃龍戍，", "頻年不解兵。", "可憐閨裡月，", "長在漢家營。", "少婦今春意，", "良人昨夜情。", "誰能將旗鼓，", "一為取龍城。"], "regions": ["hebei"] },
    { "id": "wangwei_chongyang", "year": 717, "author": "王維", "title": "九月九日憶山東兄弟", "lines": ["獨在異鄉為異客，", "每逢佳節倍思親。", "遙知兄弟登高處，", "遍插茱萸少一人。"], "note": "王維十七歲客居長安時作。" },
    { "id": "wangwan_beigu", "year": 723, "author": "王灣", "title": "次北固山下", "lines": ["客路青山外，", "行舟綠水前。", "潮平兩岸闊，", "風正一帆懸。", "海日生殘夜，", "江春入舊年。", "鄉書何處達，", "歸雁洛陽邊。"], "regions": ["yangzhou"] },
    { "id": "zuyong_zhongnan", "year": 724, "author": "祖詠", "title": "終南望餘雪", "lines": ["終南陰嶺秀，", "積雪浮雲端。", "林表明霽色，", "城中增暮寒。"], "regions": ["guanzhong"], "note": "相傳是祖詠在長安應試時所作，只寫四句就交卷，說意思已經盡了。" },
    { "id": "wanghan_liangzhou", "year": 725, "author": "王翰", "title": "涼州詞", "lines": ["葡萄美酒夜光杯，", "欲飲琵琶馬上催。", "醉臥沙場君莫笑，", "古來征戰幾人回。"], "regions": ["shazhou", "xizhou"] },
    { "id": "libai_emei", "year": 725, "author": "李白", "title": "峨眉山月歌", "lines": ["峨眉山月半輪秋，", "影入平羌江水流。", "夜發清溪向三峽，", "思君不見下渝州。"], "regions": ["yizhou"], "note": "李白二十多歲離開蜀中時所作。" },
    { "id": "libai_lushan", "year": 725, "author": "李白", "title": "望廬山瀑布", "lines": ["日照香爐生紫煙，", "遙看瀑布掛前川。", "飛流直下三千尺，", "疑是銀河落九天。"], "regions": ["yangzhou"] },
    { "id": "libai_yesi", "year": 726, "author": "李白", "title": "靜夜思", "lines": ["床前看月光，", "疑是地上霜。", "舉頭望山月，", "低頭思故鄉。"], "regions": ["yangzhou"], "note": "開元十四年李白客居揚州時作。這裡照宋本，明代以後流行的本子作「床前明月光」「舉頭望明月」。" },
    { "id": "wangcl_chusai", "year": 727, "author": "王昌齡", "title": "出塞", "lines": ["秦時明月漢時關，", "萬里長征人未還。", "但使龍城飛將在，", "不教胡馬度陰山。"], "regions": ["shazhou", "xizhou", "hebei"] },
    { "id": "meng_chunxiao", "year": 730, "author": "孟浩然", "title": "春曉", "lines": ["春眠不覺曉，", "處處聞啼鳥。", "夜來風雨聲，", "花落知多少。"] },
    { "id": "libai_guangling", "year": 730, "author": "李白", "title": "黃鶴樓送孟浩然之廣陵", "lines": ["故人西辭黃鶴樓，", "煙花三月下揚州。", "孤帆遠影碧空盡，", "唯見長江天際流。"], "regions": ["yangzhou"] },
    { "id": "wangcl_congjun", "year": 730, "author": "王昌齡", "title": "從軍行", "lines": ["青海長雲暗雪山，", "孤城遙望玉門關。", "黃沙百戰穿金甲，", "不破樓蘭終不還。"], "regions": ["shazhou", "xizhou"] },
    { "id": "meng_guren", "year": 730, "author": "孟浩然", "title": "過故人莊", "lines": ["故人具雞黍，", "邀我至田家。", "綠樹村邊合，", "青山郭外斜。", "開軒面場圃，", "把酒話桑麻。", "待到重陽日，", "還來就菊花。"] },
    { "id": "meng_jiande", "year": 730, "author": "孟浩然", "title": "宿建德江", "lines": ["移舟泊煙渚，", "日暮客愁新。", "野曠天低樹，", "江清月近人。"], "regions": ["yangzhou"] },
    { "id": "wangzh_liangzhou", "year": 735, "author": "王之渙", "title": "涼州詞", "lines": ["黃河遠上白雲間，", "一片孤城萬仞山。", "羌笛何須怨楊柳，", "春風不度玉門關。"], "regions": ["shazhou", "xizhou"] },
    { "id": "wangzh_guanque", "year": 735, "author": "王之渙", "title": "登鸛雀樓", "lines": ["白日依山盡，", "黃河入海流。", "欲窮千里目，", "更上一層樓。"], "regions": ["guanzhong", "luoyang"] },
    { "id": "dufu_wangyue", "year": 736, "author": "杜甫", "title": "望嶽", "lines": ["岱宗夫如何，", "齊魯青未了。", "造化鍾神秀，", "陰陽割昏曉。", "盪胸生層雲，", "決眥入歸鳥。", "會當凌絕頂，", "一覽眾山小。"], "regions": ["hebei"], "note": "杜甫早年漫遊齊趙時作。" },
    { "id": "zhang_wangyue", "year": 737, "author": "張九齡", "title": "望月懷遠", "lines": ["海上生明月，", "天涯共此時。", "情人怨遙夜，", "竟夕起相思。", "滅燭憐光滿，", "披衣覺露滋。", "不堪盈手贈，", "還寢夢佳期。"], "regions": ["lingnan"], "note": "張九齡是嶺南韶州人，開元二十五年貶荊州長史後所作。" },
    { "id": "wangwei_saishang", "year": 737, "author": "王維", "title": "使至塞上", "lines": ["單車欲問邊，", "屬國過居延。", "征蓬出漢塞，", "歸雁入胡天。", "大漠孤煙直，", "長河落日圓。", "蕭關逢候騎，", "都護在燕然。"], "regions": ["shazhou"], "note": "開元二十五年，王維奉使到河西節度使幕府慰問。" },
    { "id": "cuihao_huanghe", "year": 740, "author": "崔顥", "title": "黃鶴樓", "lines": ["昔人已乘黃鶴去，", "此地空餘黃鶴樓。", "黃鶴一去不復返，", "白雲千載空悠悠。", "晴川歷歷漢陽樹，", "芳草萋萋鸚鵡洲。", "日暮鄉關何處是，", "煙波江上使人愁。"], "note": "後來傳說李白登黃鶴樓，看了這首詩就不寫了。" },
    { "id": "wangwei_tianjia", "year": 740, "author": "王維", "title": "渭川田家", "lines": ["斜光照墟落，", "窮巷牛羊歸。", "野老念牧童，", "倚杖候荊扉。", "雉雊麥苗秀，", "蠶眠桑葉稀。", "田夫荷鋤至，", "相見語依依。", "即此羨閒逸，", "悵然吟式微。"], "regions": ["guanzhong"] },
    { "id": "wangcl_guiyuan", "year": 740, "author": "王昌齡", "title": "閨怨", "lines": ["閨中少婦不知愁，", "春日凝妝上翠樓。", "忽見陌頭楊柳色，", "悔教夫婿覓封侯。"] },
    { "id": "wangcl_furong", "year": 742, "author": "王昌齡", "title": "芙蓉樓送辛漸", "lines": ["寒雨連江夜入吳，", "平明送客楚山孤。", "洛陽親友如相問，", "一片冰心在玉壺。"], "regions": ["yangzhou", "luoyang"], "note": "王昌齡任江寧丞時，在潤州送朋友回洛陽。" },
    { "id": "he_huixiang", "year": 744, "author": "賀知章", "title": "回鄉偶書", "lines": ["少小離家老大回，", "鄉音無改鬢毛衰。", "兒童相見不相識，", "笑問客從何處來。"], "note": "天寶三載賀知章八十六歲，辭官回越州故鄉時作。" },
    { "id": "he_yongliu", "year": 744, "author": "賀知章", "title": "詠柳", "lines": ["碧玉妝成一樹高，", "萬條垂下綠絲絛。", "不知細葉誰裁出，", "二月春風似剪刀。"] },
    { "id": "libai_ziye", "year": 745, "author": "李白", "title": "子夜吳歌・秋歌", "lines": ["長安一片月，", "萬戶擣衣聲。", "秋風吹不盡，", "總是玉關情。", "何日平胡虜，", "良人罷遠征。"], "regions": ["guanzhong", "shazhou", "xizhou"] },
    { "id": "changjian_poshan", "year": 745, "author": "常建", "title": "題破山寺後禪院", "lines": ["清晨入古寺，", "初日照高林。", "曲徑通幽處，", "禪房花木深。", "山光悅鳥性，", "潭影空人心。", "萬籟此都寂，", "但餘鐘磬音。"], "regions": ["yangzhou"] },
    { "id": "gaoshi_dongda", "year": 747, "author": "高適", "title": "別董大", "lines": ["千里黃雲白日曛，", "北風吹雁雪紛紛。", "莫愁前路無知己，", "天下誰人不識君。"] },
    { "id": "cen_rujing", "year": 749, "author": "岑參", "title": "逢入京使", "lines": ["故園東望路漫漫，", "雙袖龍鍾淚不乾。", "馬上相逢無紙筆，", "憑君傳語報平安。"], "regions": ["shazhou", "xizhou"], "note": "天寶八載岑參第一次出塞赴安西，途中遇到回長安的使者。" },
    { "id": "wangwei_luzhai", "year": 750, "author": "王維", "title": "鹿柴", "lines": ["空山不見人，", "但聞人語響。", "返景入深林，", "復照青苔上。"], "regions": ["guanzhong"], "note": "王維輞川別業二十景之一，在藍田。" },
    { "id": "cen_qizhong", "year": 750, "author": "岑參", "title": "磧中作", "lines": ["走馬西來欲到天，", "辭家見月兩回圓。", "今夜不知何處宿，", "平沙萬里絕人煙。"], "regions": ["xizhou", "shazhou"], "note": "岑參赴安西途中，走在西州一帶的沙磧裡。" },
    { "id": "wangwei_xiangsi", "year": 750, "author": "王維", "title": "相思", "lines": ["紅豆生南國，", "春來發幾枝。", "願君多采擷，", "此物最相思。"], "regions": ["lingnan"], "note": "當時已被樂工譜曲傳唱。" },
    { "id": "wangwei_qiuming", "year": 750, "author": "王維", "title": "山居秋暝", "lines": ["空山新雨後，", "天氣晚來秋。", "明月松間照，", "清泉石上流。", "竹喧歸浣女，", "蓮動下漁舟。", "隨意春芳歇，", "王孫自可留。"], "regions": ["guanzhong"] },
    { "id": "wangwei_anxi", "year": 755, "author": "王維", "title": "送元二使安西", "lines": ["渭城朝雨浥輕塵，", "客舍青青柳色新。", "勸君更盡一杯酒，", "西出陽關無故人。"], "regions": ["guanzhong", "shazhou", "xizhou"] },
    { "id": "libai_wanglun", "year": 755, "author": "李白", "title": "贈汪倫", "lines": ["李白乘舟將欲行，", "忽聞岸上踏歌聲。", "桃花潭水深千尺，", "不及汪倫送我情。"], "regions": ["yangzhou"], "note": "李白遊宣州涇縣時作。" },
    { "id": "dufu_yueye", "year": 756, "author": "杜甫", "title": "月夜", "lines": ["今夜鄜州月，", "閨中只獨看。", "遙憐小兒女，", "未解憶長安。", "香霧雲鬟濕，", "清輝玉臂寒。", "何時倚虛幌，", "雙照淚痕乾。"], "regions": ["guanzhong"], "note": "至德元載秋，杜甫被叛軍擄到長安，妻兒留在鄜州。" },
    { "id": "zhangji_fengqiao", "year": 757, "author": "張繼", "title": "楓橋夜泊", "lines": ["月落烏啼霜滿天，", "江楓漁火對愁眠。", "姑蘇城外寒山寺，", "夜半鐘聲到客船。"], "regions": ["yangzhou"], "note": "一般認為是安史之亂後張繼避亂江南時所作。" },
    { "id": "dufu_chunwang", "year": 757, "author": "杜甫", "title": "春望", "lines": ["國破山河在，", "城春草木深。", "感時花濺淚，", "恨別鳥驚心。", "烽火連三月，", "家書抵萬金。", "白頭搔更短，", "渾欲不勝簪。"], "regions": ["guanzhong"], "note": "至德二載春，杜甫陷在叛軍佔據的長安時作。" },
    { "id": "dufu_shedi", "year": 759, "author": "杜甫", "title": "月夜憶舍弟", "lines": ["戍鼓斷人行，", "邊秋一雁聲。", "露從今夜白，", "月是故鄉明。", "有弟皆分散，", "無家問死生。", "寄書長不達，", "況乃未休兵。"], "regions": ["luoyang", "hebei"] },
    { "id": "libai_baidi", "year": 759, "author": "李白", "title": "早發白帝城", "lines": ["朝辭白帝彩雲間，", "千里江陵一日還。", "兩岸猿聲啼不住，", "輕舟已過萬重山。"], "regions": ["yizhou"], "note": "乾元二年李白流放夜郎，行至白帝城遇赦東歸。" },
    { "id": "dufu_shihao", "year": 759, "author": "杜甫", "title": "石壕吏", "lines": ["暮投石壕村，", "有吏夜捉人。", "老翁踰牆走，", "老婦出門看。", "吏呼一何怒，", "婦啼一何苦。", "聽婦前致詞，", "三男鄴城戍。", "一男附書至，", "二男新戰死。", "存者且偷生，", "死者長已矣。", "室中更無人，", "惟有乳下孫。", "有孫母未去，", "出入無完裙。", "老嫗力雖衰，", "請從吏夜歸。", "急應河陽役，", "猶得備晨炊。", "夜久語聲絕，", "如聞泣幽咽。", "天明登前途，", "獨與老翁別。"], "regions": ["luoyang"], "note": "乾元二年，官軍在鄴城潰敗，朝廷在河南各地捉人補兵。杜甫從洛陽回華州途中，宿在陝州石壕村。" },
    { "id": "dufu_shuxiang", "year": 760, "author": "杜甫", "title": "蜀相", "lines": ["丞相祠堂何處尋，", "錦官城外柏森森。", "映階碧草自春色，", "隔葉黃鸝空好音。", "三顧頻煩天下計，", "兩朝開濟老臣心。", "出師未捷身先死，", "長使英雄淚滿襟。"], "regions": ["yizhou"], "note": "杜甫初到成都，去看諸葛亮的祠堂。" },
    { "id": "dufu_xiyu", "year": 761, "author": "杜甫", "title": "春夜喜雨", "lines": ["好雨知時節，", "當春乃發生。", "隨風潛入夜，", "潤物細無聲。", "野徑雲俱黑，", "江船火獨明。", "曉看紅濕處，", "花重錦官城。"], "regions": ["yizhou"], "note": "上元二年春，杜甫在成都草堂所作。" },
    { "id": "dufu_huangsiniang", "year": 761, "author": "杜甫", "title": "江畔獨步尋花", "lines": ["黃四娘家花滿蹊，", "千朵萬朵壓枝低。", "留連戲蝶時時舞，", "自在嬌鶯恰恰啼。"], "regions": ["yizhou"], "note": "七首之六。黃四娘是杜甫草堂的鄰居。" },
    { "id": "dufu_kezhi", "year": 761, "author": "杜甫", "title": "客至", "lines": ["舍南舍北皆春水，", "但見群鷗日日來。", "花徑不曾緣客掃，", "蓬門今始為君開。", "盤飧市遠無兼味，", "樽酒家貧只舊醅。", "肯與鄰翁相對飲，", "隔籬呼取盡餘杯。"], "regions": ["yizhou"] },
    { "id": "dufu_shouhebei", "year": 763, "author": "杜甫", "title": "聞官軍收河南河北", "lines": ["劍外忽傳收薊北，", "初聞涕淚滿衣裳。", "卻看妻子愁何在，", "漫卷詩書喜欲狂。", "白日放歌須縱酒，", "青春作伴好還鄉。", "即從巴峽穿巫峽，", "便下襄陽向洛陽。"], "note": "廣德元年春，杜甫在梓州聽到叛亂平定的消息。" }
  ]
}
