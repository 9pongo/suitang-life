{
  "events": [
    { "id": "f_good_harvest", "kind": "flavor", "group": "weather", "w": 3, "repeat": 3, "repeatGap": 5, "scene": "harvest",
      "req": { "age": [10, 70], "cls": ["junfarmer", "kehu", "fubing", "siyuan", "lizheng"] }, "eff": { "財": 2, "健": 2 },
      "text": "今年風調雨順，交完租還剩下不少。家裡做了一鍋粟米飯，大家吃得肚皮都圓了。",
      "alt": ["這一年雨水來得正是時候，麥穗壓彎了稈子。打完場，倉裡堆得滿滿的，家裡殺了一隻雞。", "秋收的時候，連最薄的那塊地都多收了兩斗。里中家家戶戶曬穀，空氣裡都是糠的味道。"] },
    { "id": "f_drought", "kind": "flavor", "group": "weather", "w": 2, "repeat": 3, "repeatGap": 6, "scene": "drought",
      "req": { "age": [10, 70], "cls": ["junfarmer", "kehu", "fubing", "siyuan", "lizheng"] }, "eff": { "財": -3, "健": -3 },
      "text": "一整個夏天沒下過一場透雨。地裂得能塞進手指頭，粟苗一片一片地枯了。",
      "alt": ["旱了。縣令帶著父老去祈雨，跪了三天，天上還是一片雲都沒有。", "井水一天比一天淺。你半夜起來挑水澆苗，挑到天亮，地還是乾的。"] },
    { "id": "f_flood", "kind": "flavor", "group": "weather", "w": 1, "repeat": 2, "repeatGap": 8, "scene": "flood",
      "req": { "age": [10, 70], "cls": ["junfarmer", "kehu", "fubing", "siyuan", "lizheng"], "noregion": ["shazhou", "xizhou"] }, "eff": { "財": -3 },
      "text": "連下了半個月的雨，河水漫過了堤。田淹了一半，你家的牆也塌了一角。",
      "alt": ["秋雨下個不停，麥子還沒收就爛在了地裡。"] },
    { "id": "f_locust", "kind": "flavor", "group": "weather", "w": 1, "repeat": 2, "repeatGap": 10, "scene": "locust",
      "req": { "age": [10, 70], "cls": ["junfarmer", "kehu", "fubing", "siyuan", "lizheng"], "noregion": ["lingnan", "yizhou"] }, "eff": { "財": -4 },
      "text": "蝗蟲來了。天邊先是一片黃雲，接著就落了下來，啃得田裡只剩下光禿禿的稈子。",
      "alt": ["里正帶著人在田邊挖溝、點火，想把蝗蟲燒死。燒死了一批，又飛來一批。"] },
    { "id": "f_father", "kind": "flavor", "w": 2, "scene": "funeral",
      "req": { "age": [18, 60], "noflag": "father_dead", "flagFor": { "mother_dead": 1 } }, "eff": { "flag": "father_dead", "財": -2 },
      "text": "父親過世了。按規矩要守喪，可田裡的活不等人。你在墳前磕了三個頭，第二天還是下了地。",
      "alt": ["父親走的那天，天剛下過雨。他最後一句話是交代你，東邊那塊地的田埂該修了。", "父親病了一個冬天，開春的時候走了。歲末造手實，里正在父親的名字底下寫了一個「死」字，戶主改成了你。"],
      "textIf": [
        { "req": { "away": true }, "text": "家裡捎來消息：父親過世了。等你告了假趕回家，墳上的土已經乾了。" },
        { "req": { "cls": ["gentry_gl", "gentry_sd", "gentry_jn"] }, "text": "父親過世了。你在墓旁搭了一間草廬，照著禮守喪，不飲酒、不食肉。" },
        { "req": { "cls": "gongshang" }, "text": "父親過世了。按規矩要守喪，可鋪子不能一直關著。你在墳前磕了三個頭，第二天還是卸下了門板。" },
        { "req": { "cls": "hu" }, "text": "父親過世了。按家裡的規矩，請了祆祠的人來，把他的屍骨收進一個刻著火壇的骨甕裡。" }
      ] },
    { "id": "f_mother", "kind": "flavor", "w": 1, "scene": "funeral",
      "req": { "age": [22, 60], "noflag": "mother_dead", "flagFor": { "father_dead": 1 } }, "eff": { "flag": "mother_dead" },
      "text": "母親過世了。整理她的東西時，你在箱底找到一雙你小時候穿過的鞋。",
      "alt": ["母親過世了。出殯那天，坊裡的婦人都來了，說她這輩子沒跟誰紅過臉。", "母親走得很安靜。你在她的枕頭底下找到一小串銅錢，用紅繩穿著，上面繫著寫了你名字的布條。"],
      "textIf": [ { "req": { "away": true }, "text": "營裡來了一封家書，你請識字的人唸給你聽。唸到「母親已於上月過世」，那人停了下來，你說，往下唸吧。" } ] },
    { "id": "f_child_die", "kind": "flavor", "w": 1, "repeat": 2, "repeatGap": 4, "scene": "funeral",
      "req": { "age": [17, 50], "flag": "has_child", "child": [0, 6] }, "eff": { "childDie": true, "健": -6 },
      "text": "{young}沒能熬過冬天。你在屋後的桑樹下挖了一個小坑。那年，你很少說話。",
      "alt": ["一場高燒，帶走了{young}。你剛給孩子縫好一件新衣服，再也穿不上了。"] },
    { "id": "f_sick", "kind": "flavor", "w": 2, "repeat": 3, "repeatGap": 8, "scene": "sick",
      "req": { "age": [8, 80] }, "eff": { "健": -6 },
      "text": "你病了一場，咳了一個多月才好。醫人開的藥方上，寫著甘草、麻黃，還有一味你不認得的東西。",
      "alt": ["你發了一場熱病，在床上躺了半個月。好了以後，走路還是腿軟。", "你的腰疼了一整個冬天，彎不下去，也直不起來。"] },
    { "id": "f_shoushi", "kind": "flavor", "w": 2, "year": [624, 763], "familyRepeat": true, "repeat": 2, "repeatGap": 15, "tag": "官府", "scene": "registry",
      "req": { "age": [20, 70], "nofaction": "rebel", "nocls": "kehu" },
      "text": "歲末，里正挨家挨戶收手實。你請人照著格式寫：戶主某，年若干，丁；妻某，年若干，丁妻；男某，年若干，小……合應受田若干畝，已受若干，未受若干。最後一句是：「右件人口田畝，並皆依實，若後有隱漏，請依法受罪。」",
      "alt": ["里正把今年的手實收上去了。他說，三年一造籍，今年的帳要送到州裡，一個字也錯不得。", "造手實的時候，里正拿著去年的帳一行一行對。對到你家，他抬頭看了你一眼，說：今年添了口，好事。"] },
    { "id": "f_chaike", "kind": "flavor", "w": 2, "year": [624, 763], "familyRepeat": true, "repeat": 2, "repeatGap": 10, "tag": "官府", "scene": "registry",
      "req": { "age": [21, 58], "gender": "m", "nofaction": "rebel", "nocls": ["kehu", "gentry_gl", "gentry_sd", "gentry_jn"] }, "eff": { "健": -2 },
      "text": "縣裡排差科簿，你的名字底下注了一個「門夫」：這一年要輪著去縣衙守門。",
      "textIf": [
        { "req": { "region": ["shazhou", "xizhou"] }, "text": ["差科簿上，你被派了「烽子」：輪班到城外的烽燧上守著，看見西邊起了煙，就點火傳下去。", "差科簿上，你被派了「渠頭」：管著一段渠的水，一戶一戶照時辰放。放早了、放晚了，都有人上門罵。"] }
      ] },
    { "id": "f_zuyong", "kind": "flavor", "w": 2, "year": [624, 763], "familyRepeat": true, "repeat": 3, "repeatGap": 8, "tag": "官府", "scene": "registry",
      "req": { "age": [21, 58], "gender": "m", "cls": ["junfarmer", "fubing", "lizheng", "hu"], "nofaction": "rebel" }, "eff": { "財": -2 },
      "text": "秋後交租調：租粟二石，調絹二丈、綿三兩。家裡的女人織了大半年的絹，量過尺寸，蓋了官印，就送走了。",
      "textIf": [ { "req": { "region": ["lingnan", "yizhou", "yangzhou"] }, "text": "秋後交租調。你們這裡不產絲綿，調交的是布二丈五尺、麻三斤。縣吏拿著尺子量布，量了三遍才收。" } ] },
    { "id": "f_corvee", "kind": "flavor", "w": 2, "repeat": 2, "repeatGap": 6, "tag": "官府", "scene": "labor",
      "req": { "age": [21, 50], "gender": "m", "nofaction": "rebel", "nocls": ["gentry_gl", "gentry_sd", "gentry_jn"] }, "eff": { "健": -3 },
      "text": "輪到你家服役了。你背著乾糧去修城牆，在工地上睡了二十天，回來的時候手上全是血泡。",
      "alt": ["縣裡要疏濬渠道，你被點去挑了二十天的泥。回家那天，鞋底磨穿了。"] },
    { "id": "f_market", "kind": "flavor", "w": 2, "repeat": 2, "repeatGap": 10, "tag": "日常", "scene": "market",
      "req": { "age": [8, 70] }, "eff": { "財": -1, "名": 1 },
      "text": "你去了一趟州裡的市。午時擊鼓開市，日落前擊鉦散市，一條街上賣布的、賣鐵器的、賣胡餅的，一家挨著一家。",
      "textIf": [
        { "req": { "region": "guanzhong", "year": [618, 763] }, "text": ["你去逛了東市。肉行、鐵行、筆行一行一行排過去，牆上貼著牙人寫的告示。", "你去逛了西市。胡商開的酒肆裡飄出葡萄酒的味道，賣珠寶的胡人蹲在門口，見人就招手。"] },
        { "req": { "region": "luoyang", "year": [618, 763] }, "text": "你去逛了洛陽的南市。一行挨著一行，聽說有上百行、幾千家鋪子，你走到天黑也沒走完。" },
        { "req": { "region": "shazhou" }, "text": "你去了一趟敦煌的市。粟特人賣香料和銀器，吐谷渾人賣馬，漢人的鋪子裡賣的是絹和麥。人人說話都夾著好幾種話。" }
      ] },
    { "id": "f_caravan", "kind": "flavor", "w": 1, "repeat": 2, "repeatGap": 12, "tag": "日常", "scene": "caravan",
      "req": { "age": [6, 70], "region": ["guanzhong", "luoyang", "hebei", "shazhou", "yangzhou"] }, "eff": { "名": 1 },
      "text": "一支駝隊進了城。駱駝背上堆著成捆的絹，領頭的胡商戴著尖頂的帽子，鬍子捲得像羊毛。",
      "alt": ["胡商在坊門口卸貨，箱子裡是胡椒、象牙和一面亮得照得見人的銀盤。孩子們圍著看，被他用胡語笑著趕開。"] },
    { "id": "f_hanshi", "kind": "flavor", "w": 2, "repeat": 2, "repeatGap": 12, "tag": "族裡", "scene": "grave",
      "req": { "age": [8, 80] },
      "text": "寒食節，家家不舉火，吃的是前一天做好的冷粥和麥餅。第二天清明，你跟著家人去上墳，在墳頭壓了幾張紙錢。",
      "alt": ["寒食那幾天，坊裡的孩子們在樹上掛了鞦韆，盪得比牆還高。大人們去上墳，回來的路上折了幾枝柳條插在門上。"] },
    { "id": "f_shangyuan", "kind": "flavor", "w": 2, "repeat": 2, "repeatGap": 10, "tag": "日常", "scene": "festival",
      "req": { "age": [5, 70], "year": [713, 763], "region": ["guanzhong", "luoyang", "yangzhou", "yizhou"] }, "eff": { "名": 1 },
      "text": "正月十五上元夜，城裡不宵禁。燈輪、燈樹一座比一座高，你擠在人群裡，被人踩掉了一隻鞋。",
      "alt": ["上元夜，你們一家走到街上看燈。踏歌的女子手拉著手，從坊門一直唱到天亮。"] },
    { "id": "f_xingxiang", "kind": "flavor", "w": 2, "repeat": 2, "repeatGap": 10, "tag": "日常", "scene": "temple",
      "req": { "age": [5, 75] }, "eff": { "德": 1 },
      "text": "四月八日佛誕，寺裡的佛像抬出來繞城行像。你跟著人群一路走，看和尚們用香湯給佛像洗身子。",
      "textIf": [ { "req": { "region": "shazhou" }, "text": "二月八日，敦煌的寺院把佛像抬上車，繞城行像。社裡的人都出了錢，你家也分到了一碗齋飯。" } ] },
    { "id": "f_yulan", "kind": "flavor", "w": 1, "repeat": 2, "repeatGap": 12, "tag": "族裡", "scene": "temple",
      "req": { "age": [15, 80] }, "eff": { "德": 1 },
      "text": "七月十五，寺裡做盂蘭盆會。你送了一盆供養，替過世的長輩念了一卷經。",
      "alt": ["盂蘭盆節，寺院裡擺滿了各家送來的盆，盆上綴著花和綵。你在人群裡找了半天，才找到自家那一盆。"] },
    { "id": "f_she_feast", "kind": "flavor", "w": 3, "repeat": 3, "repeatGap": 4, "tag": "社邑", "scene": "she",
      "req": { "age": [25, 80], "flag": "in_she" }, "eff": { "名": 1, "健": 1 },
      "text": "春社那天，社人照轉帖上寫的時辰，各帶麥一斗、粟一斗、油一合到社官家裡。祭過了社神，大家坐下來吃了一整天。",
      "alt": ["秋座局席，輪到你家做東。社司的轉帖傳了一圈，最後一個看到的人要把帖子送回來；遲到的人罰酒一角。"] },
    { "id": "f_she_help", "kind": "flavor", "w": 2, "repeat": 2, "repeatGap": 6, "tag": "社邑", "scene": "funeral",
      "req": { "age": [25, 80], "flag": "in_she" }, "eff": { "德": 2, "財": -1 },
      "text": "社裡有一戶辦喪事。社司發了轉帖：「右緣某家亡過，准條合有贈送，人各粟一斗、餅二十翻、柴一束，帖至並限今月某日卯時，於某家門前取齊。」你照數送去了。",
      "alt": ["社裡的一戶人家失了火。社長召集大家，一家出一根椽子、兩捆草，不到十天就把房子重新蓋了起來。"] },
    { "id": "f_tea", "kind": "flavor", "w": 1, "year": [725, 763], "familyRepeat": true, "tag": "日常", "scene": "home",
      "req": { "age": [20, 80] },
      "text": "這幾年興起了喝茶。城裡開了茶鋪，把茶餅烤過、碾碎，加鹽煮。你第一次喝，苦得皺眉，後來卻一天不喝就想。" },
    { "id": "f_letter", "kind": "flavor", "w": 1, "repeat": 2, "repeatGap": 12, "tag": "人情", "scene": "study",
      "req": { "age": [20, 70] }, "eff": { "名": 1 },
      "text": "你要給遠方的親戚捎信，請學堂的先生代筆。他照著書儀的格式寫：「季春極暄，伏惟某官尊體動止萬福……」你聽不太懂，只叫他最後加一句：家裡都好。" },
    { "id": "f_neighbor_wed", "kind": "flavor", "w": 2, "repeat": 2, "repeatGap": 8, "tag": "鄰里", "scene": "wedding",
      "req": { "age": [8, 70] },
      "text": "鄰家娶媳婦，院子裡搭了青廬。新婦坐在裡頭，一群人圍著唱催妝詩，新郎被堵在門外作了三首才進得去。" },
    { "id": "f_ox", "kind": "flavor", "w": 1, "repeat": 1, "tag": "農事", "scene": "field",
      "req": { "age": [20, 65], "cls": ["junfarmer", "fubing", "lizheng", "siyuan"] }, "eff": { "財": -3 },
      "text": "家裡的牛病了，趴在牛欄裡不肯起來。你守了它兩夜，第三天早上，它還是沒了氣。一家人看著空欄，誰都沒說話。" },
    { "id": "f_silk", "kind": "flavor", "w": 2, "repeat": 2, "repeatGap": 6, "tag": "家事", "scene": "loom",
      "req": { "age": [12, 60], "gender": "f", "noregion": ["shazhou", "xizhou", "lingnan"] }, "eff": { "財": 2 },
      "text": "今年的蠶養得好。你守著蠶箔，夜裡起來添了三回桑葉，聽著滿屋子沙沙的聲音睡不著。繅出來的絲，夠織交調的絹了。",
      "alt": ["你坐在織機前，從天亮織到天黑。家裡要交的那兩丈絹，一寸一寸地從你手底下長出來。"] },
    { "id": "f_thief", "kind": "flavor", "w": 1, "repeat": 1, "tag": "鄰里", "scene": "night",
      "req": { "age": [20, 70] }, "eff": { "財": -2 },
      "text": "夜裡進了賊，把家裡的兩匹絹和一甕粟都偷走了。你去報了里正，里正搖搖頭，說這年頭，找不回來的。" },
    { "id": "f_wolf", "kind": "flavor", "w": 1, "repeat": 1, "tag": "農事", "scene": "field",
      "req": { "age": [10, 60], "region": ["guanzhong", "hebei", "shazhou"] }, "eff": { "武": 1 },
      "text": "冬天夜裡，狼摸到了村口，叼走了鄰家的一隻羊。第二天，里中的男人拿著棍棒去山邊轉了一整天。" },
    { "id": "f_monk_alms", "kind": "flavor", "w": 1, "repeat": 2, "repeatGap": 10, "tag": "人情", "scene": "road",
      "req": { "age": [10, 70] }, "eff": { "德": 1 },
      "text": "一個雲遊的和尚在你家門口托缽。你給他盛了一碗飯，他吃完了，說從五台山來，要往南方去。" },
    { "id": "f_puppet", "kind": "flavor", "w": 2, "repeat": 2, "repeatGap": 8, "tag": "日常", "scene": "puppet",
      "req": { "age": [5, 60] }, "eff": { "名": 1 },
      "text": "里中來了一班耍傀儡的。木頭刻的偶人吊著線，在布幕上又唱又跳，演的是一段古時候的故事。你看得入了迷，散場了還不肯走。",
      "alt": ["坊門口有人耍窟礧子，偶人會作揖、會翻跟斗，最後還提著刀把一個壞人砍倒了。孩子們拍著手叫好。"] },
    { "id": "f_drum", "kind": "flavor", "w": 1, "year": [636, 763], "familyRepeat": true, "tag": "日常", "scene": "night",
      "req": { "age": [8, 80], "region": ["guanzhong", "luoyang"] },
      "text": "日落時，街上的鼓響了，一聲接一聲，響完了坊門就要關。你從東邊趕回來，鼓聲停的時候，正好擠進坊門。" },
    { "id": "f_refugee", "kind": "flavor", "w": 1, "repeat": 2, "repeatGap": 15, "tag": "人情", "scene": "flee",
      "req": { "age": [15, 70] }, "eff": { "德": 1, "財": -1 },
      "text": "幾戶逃荒的人家從北邊過來，在村口的破廟裡住下了。你給他們送了半斗粟，他們跪在地上磕頭。" },
    { "id": "f_harbor", "kind": "flavor", "w": 2, "repeat": 2, "repeatGap": 10, "tag": "日常", "scene": "harbor",
      "req": { "age": [6, 70], "region": "lingnan" }, "eff": { "財": 1 },
      "text": "番舶進港了。船身又高又大，桅杆上掛著好幾面帆，船上的崑崙奴皮膚黝黑，扛著一箱一箱的香料下船。",
      "alt": ["港口邊上，從波斯、獅子國來的商人在跟收稅的官吏爭價錢，你聽了半天，一句也聽不懂。"] },
    { "id": "f_brocade", "kind": "flavor", "w": 2, "repeat": 2, "repeatGap": 10, "tag": "手藝", "scene": "loom",
      "req": { "age": [8, 70], "region": "yizhou" }, "eff": { "財": 1 },
      "text": "錦江邊上，織錦的人家把新織好的錦拿到江水裡漂洗。日頭底下，一匹一匹的錦攤開來，紅的綠的晃得人眼花。" },
    { "id": "f_cave", "kind": "flavor", "w": 2, "repeat": 2, "repeatGap": 10, "tag": "日常", "scene": "cave",
      "req": { "age": [6, 75], "region": "shazhou" }, "eff": { "德": 1 },
      "text": "鳴沙山的崖上又在開新窟。畫匠吊在架子上，一筆一筆畫飛天的衣帶。供養人的畫像畫在窟門邊上，你認出了其中一個是城裡的大戶。",
      "alt": ["你跟著家裡人去莫高窟燒香。窟裡很暗，點起燈來，牆上的菩薩好像在看著你笑。"] },
    { "id": "f_saltboat", "kind": "flavor", "w": 2, "repeat": 2, "repeatGap": 10, "tag": "日常", "scene": "canal",
      "req": { "age": [6, 70], "region": "yangzhou" }, "eff": { "財": 1 },
      "text": "運河上的船一艘挨著一艘，有運米的、運鹽的，也有掛著綵旗載官人的。碼頭上的腳夫喊著號子，從天亮扛到天黑。" },
    { "id": "f_karez", "kind": "flavor", "w": 2, "repeat": 2, "repeatGap": 10, "tag": "農事", "scene": "field",
      "req": { "age": [8, 70], "region": "xizhou" },
      "text": "火焰山下熱得像蒸籠。地底下的坎兒井把雪水從遠處引過來，你趴在井口喝了一口，冰得牙疼。" },
    { "id": "f_peony", "kind": "flavor", "w": 1, "year": [720, 755], "familyRepeat": true, "tag": "日常", "scene": "festival",
      "req": { "age": [10, 80], "region": ["guanzhong", "luoyang"] },
      "text": "這幾年城裡興起了種牡丹。大戶人家的院子裡一叢一叢地開，花開的時候，門口擠滿了看花的人。你擠進去看了一眼，回來跟家裡人說，那花有碗口那麼大。" },
    { "id": "lc_qianziwen", "kind": "flavor", "w": 3, "tag": "讀書", "scene": "study",
      "req": { "age": [6, 12], "focus": "讀書識字" }, "eff": { "文": 2 },
      "text": "你在學堂裡念《千字文》：天地玄黃，宇宙洪荒。先生念一句，你們跟一句，念錯了，手心就挨一下戒尺。" },
    { "id": "lc_zhuma", "kind": "flavor", "w": 2, "tag": "童年", "scene": "play",
      "req": { "age": [5, 10] }, "eff": { "健": 2 },
      "text": "你和{friend}騎著竹馬在巷子裡跑，一個當將軍，一個當賊，從坊東打到坊西。" },
    { "id": "lc_lost", "kind": "flavor", "w": 1, "tag": "童年", "scene": "market",
      "req": { "age": [4, 9] },
      "text": "你跟著大人去趕集，在人堆裡走散了。你站在一個賣胡餅的攤子邊哭，攤主塞給你半個餅，一直等到你家的人找來。" },
    { "id": "lc_stars", "kind": "flavor", "w": 2, "tag": "童年", "scene": "night",
      "req": { "age": [5, 12] },
      "text": "夏夜，大人在院子裡乘涼，指著天上說，那條白白的是天河，牛郎織女一年只能見一面。你數著星星，數著數著就睡著了。" },
    { "id": "lo_grand", "kind": "flavor", "w": 2, "tag": "晚年", "scene": "old",
      "req": { "age": [58, 95], "flag": "has_child", "child": [18, 80] }, "eff": { "健": 2 },
      "text": "{kid}的孩子會走路了，搖搖晃晃地撲到你懷裡。你抱著那個小身子，覺得這輩子吃過的苦，好像也沒那麼苦了。" },
    { "id": "lo_sun", "kind": "flavor", "w": 2, "repeat": 2, "repeatGap": 6, "tag": "晚年", "scene": "old",
      "req": { "age": [65, 95] }, "eff": { "健": 1 },
      "text": "你坐在門口曬太陽，看巷子裡的孩子們跑來跑去。有時候叫錯了名字，把這一代的孩子叫成了上一代的。",
      "alt": ["冬天的日頭短，你坐在牆根底下的石頭上，一坐就是一下午。路過的人跟你打招呼，你點點頭，其實已經看不太清是誰了。", "你的牙掉得差不多了，家裡煮飯總要替你多燜一會兒。你嘴上說不用麻煩，心裡是高興的。", "夜裡睡不沉，雞叫頭遍你就醒了。躺在床上，從前的事一件一件想起來，倒比昨天的事記得還清楚。"] },
    { "id": "lo_story", "kind": "flavor", "w": 2, "tag": "晚年", "scene": "old",
      "req": { "age": [62, 95] },
      "text": "晚上，孩子們圍著你，要你講從前的事。你講到一半，才發現他們聽的是故事，你講的卻是自己的一輩子。",
      "textIf": [ { "req": { "year": [640, 700], "born": [574, 600] }, "text": "孩子們圍著你，要你講隋朝的事。你說那時候天下的人都在挖運河、去遼東，孩子們聽了直笑，說哪有這麼傻的事。" } ] },
    { "id": "f_camp_home", "kind": "flavor", "w": 3, "camp": true, "repeat": 2, "repeatGap": 2, "scene": "army",
      "req": { "age": [15, 60] },
      "text": "營裡的夜很長。有人吹起了笛子，吹的是家鄉的調子，帳篷裡一個個都翻過身去，假裝睡著了。" },
    { "id": "f_camp_march", "kind": "flavor", "w": 2, "camp": true, "repeat": 2, "repeatGap": 2, "scene": "army",
      "req": { "age": [15, 60] }, "eff": { "健": -2 },
      "text": "行軍了一整天，腳上的草鞋磨穿了。火長讓大家圍著火堆烤腳，一人分了一塊乾硬的胡餅。" },
    { "id": "p_liao_tale", "kind": "flavor", "w": 3, "familyOnce": true, "tag": "族裡", "scene": "old",
      "req": { "age": [8, 70], "flag": "p_liao" },
      "text": "{elder}說過，大業那年被徵去遼東，一路從涿郡走過去，路邊躺的都是死人。家裡人說起這件事，總說：能回來，就是祖上積了德。" },
    { "id": "p_canal_tale", "kind": "flavor", "w": 3, "familyOnce": true, "tag": "族裡", "scene": "canal",
      "req": { "age": [8, 70], "flag": "p_canal" },
      "text": "{elder}年輕時被徵去開運河，在泥水裡站了好幾個月。家裡人說，如今運河上的船來來往往，誰也不記得是誰挖的。" },
    { "id": "p_rebel_tale", "kind": "flavor", "w": 3, "familyOnce": true, "tag": "族裡", "scene": "army",
      "req": { "age": [8, 70], "flag": "p_rebel_joined" },
      "text": "家裡的長輩不太說{elder}當年投義軍的事。偶爾喝了酒，才說一句：那年頭，不反，就得餓死。" },
    { "id": "p_luokou_tale", "kind": "flavor", "w": 3, "familyOnce": true, "tag": "族裡", "scene": "harvest",
      "req": { "age": [8, 70], "flag": "p_luokou" },
      "text": "{elder}說過，大業末年，瓦崗軍打開了洛口倉，任人去背米。路上掉的米鋪了厚厚一層，踩上去沙沙作響。" },
    { "id": "p_sold_tale", "kind": "flavor", "w": 3, "familyOnce": true, "tag": "族裡", "scene": "home",
      "req": { "age": [8, 70], "flag": "p_sold_child" },
      "text": "家裡人說，貞觀二年關中大旱，{elder}賣過一個孩子，後來朝廷出錢贖了回來。那個孩子長大以後，每年都要去給{elder}上墳。" },
    { "id": "p_official_tale", "kind": "flavor", "w": 3, "familyOnce": true, "tag": "族裡", "scene": "study",
      "req": { "age": [8, 70], "flag": "p_official" },
      "text": "{elder}做過官，家裡還留著那時候的告身，捲在一個布套裡。逢年過節，長輩才拿出來給孩子們看一眼。" },
    { "id": "p_jiushi_tale", "kind": "flavor", "w": 3, "familyOnce": true, "tag": "族裡", "scene": "flee",
      "req": { "age": [8, 70], "flag": "p_jiushi" },
      "text": "{elder}說過，開皇年間關中大旱，皇帝帶著百姓到洛陽去就食。一路上，衛士不許驅趕百姓，皇帝見了扶老攜幼的人，還讓開路給他們先走。" },
    { "id": "p_qidan_tale", "kind": "flavor", "w": 3, "familyOnce": true, "tag": "族裡", "scene": "flee",
      "req": { "age": [8, 70], "flag": "p_qidan_fled" },
      "text": "{elder}說過，萬歲通天年間契丹人打進河北，一家人躲在河灘的蘆葦裡，三天三夜不敢生火。" },
    { "id": "p_xuanzang_tale", "kind": "flavor", "w": 3, "familyOnce": true, "tag": "族裡", "scene": "road",
      "req": { "age": [8, 70], "flag": "p_xuanzang" },
      "text": "{elder}常說，年輕時見過玄奘法師。那時候他還不是什麼大法師，只是一個要偷偷出關的和尚。" },
    { "id": "p_yan_tale", "kind": "flavor", "w": 3, "familyOnce": true, "tag": "族裡", "scene": "flee",
      "req": { "age": [6, 70], "flag": "p_yan_fled" },
      "text": "{elder}說過，那年范陽的兵打過來，一家人什麼都沒帶，只抱著籍帳和一包種子就上了路。{elder}說：籍帳在，家就在。" }
  ]
}
